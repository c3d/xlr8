OP(null,    ,           rt.error("Null opcode bug"); done = true)

OP(undef,   TOK,        done = !resolve(t, called, pc, true))
OP(end,     ,           done = true)

OP(int,     DST KINT,   DINT = kint)
OP(nat,     DST KNAT,   DNAT = knat)
OP(flt,     DST KFLT,   memcpy(&DFLT, pc, sizeof(float)); pc += sizeof(float))
OP(dbl,     DST KDBL,   memcpy(&DDBL, pc, sizeof(double)); pc += sizeof(double))
OP(txt,     DST TOK,    DNAT = t)

OP(copy,    DST SRC,    DALL = SALL)
OP(swap,    DST SRC,    std::swap(DALL, SALL))
OP(ccopy,   PRED DST SRC,       if (flags & PMASK) DALL = SALL)
OP(select,  PRED DST SRC XTRA,  DALL = (flags & PMASK) ? SALL : XALL)

OP(jmp,     TOK,        JMP_TOK)
OP(call,    TOK,        called = t; done = !push(value_t(pc)); JMP_TOK)
OP(ijmp,    SRC,        pc = byte_p(SNAT))
OP(icall,   SRC,        done = !push(value_t(pc)); pc = byte_p(SNAT))
OP(ret,     ,           pc = byte_p(pop()))
OP(ppc,     ,           push(value_t(pc)))
OP(pc,      DST,        DNAT = uvalue_t(pc))
OP(pca,     DST BRA, DNAT = uvalue_t(bpc + b))
OP(enter,   DST,        this->flags = flags; args = frame; frame = enter(d); done = !frame)
OP(leave,   ,           frame = leave(); done = !frame; flags = this->flags; args = arguments())
OP(get,     DST SRC,    DINT = args[s])
OP(set,     DST SRC,    args[d] = SINT)
OP(push,    SRC,        done = !push(SALL))
OP(pop,     DST,        DALL = pop())
OP(sys,     TOK,        FLUSH; done = !native(t); RESYNC)
OP(sto,     DST SRC,    globals[d] = SINT)
OP(rcl,     DST SRC,    DINT = globals[s])

OP(dbra,    DST BRA,    if (--DNAT) BRANCH)
OP(bra,     BRA,        BRANCH)
OP(btrue,   PRED BRA,   if (  flags & PMASK)  BRANCH)
OP(bfalse,  PRED BRA,   if (!(flags & PMASK)) BRANCH)
OP(beq,     SRC BRA,    if (SINT == 0) BRANCH)
OP(bne,     SRC BRA,    if (SINT != 0) BRANCH)
OP(blt,     SRC BRA,    if (SINT <  0) BRANCH)
OP(bgt,     SRC BRA,    if (SINT >  0) BRANCH)
OP(ble,     SRC BRA,    if (SINT <= 0) BRANCH)
OP(bge,     SRC BRA,    if (SINT >= 0) BRANCH)
OP(switch,  SRC,        pc = dispatch(pc, SINT, std::equal_to<intptr_t>()))
OP(dispatch,SRC,        pc = dispatch(pc, SINT, std::greater_equal<intptr_t>()))

OP(true,    PRED,          PCOND(true))
OP(false,   PRED,          PCOND(false))
OP(cmpeq,   PRED DST SRC,  PCOND(DINT == SINT))
OP(cmpne,   PRED DST SRC,  PCOND(DINT != SINT))
OP(cmplt,   PRED DST SRC,  PCOND(DINT <  SINT))
OP(cmple,   PRED DST SRC,  PCOND(DINT <= SINT))
OP(cmpult,  PRED DST SRC,  PCOND(DNAT <  SNAT))
OP(cmpule,  PRED DST SRC,  PCOND(DNAT <= SNAT))
OP(cmpeqi,  PRED DST KINT, PCOND(DINT == kint))
OP(cmpnei,  PRED DST KINT, PCOND(DINT != kint))
OP(cmplti,  PRED DST KINT, PCOND(DINT <  kint))
OP(cmplei,  PRED DST KINT, PCOND(DINT <= kint))
OP(cmpequ,  PRED DST KNAT, PCOND(DNAT == knat))
OP(cmpneu,  PRED DST KNAT, PCOND(DNAT != knat))
OP(cmpltu,  PRED DST KNAT, PCOND(DNAT <  knat))
OP(cmpleu,  PRED DST KNAT, PCOND(DNAT <= knat))

OP(pushf,   ,           rt.push(flags))
OP(popf,    ,           flags = rt.pop<uint64_t>())

OP(add,     DST SRC,    DINT += SINT)
OP(sub,     DST SRC,    DINT -= SINT)
OP(mul,     DST SRC,    DINT *= SINT)
OP(umul,    DST SRC,    DNAT *= SNAT)
OP(div,     DST SRC,    DINT /= SINT)
OP(udiv,    DST SRC,    DNAT /= SNAT)
OP(mod,     DST SRC,    DINT %= SINT)
OP(umod,    DST SRC,    DNAT %= SNAT)

OP(and,     DST SRC,    DNAT  &= SNAT)
OP(or,      DST SRC,    DNAT  |= SNAT)
OP(xor,     DST SRC,    DNAT  ^= SNAT)
OP(shl,     DST SRC,    DNAT <<= SNAT)
OP(shr,     DST SRC,    DINT >>= SNAT)
OP(ushr,    DST SRC,    DNAT >>= SNAT)
OP(neg,     DST,        DNAT = -DNAT)
OP(not,     DST,        DNAT = ~DNAT)

OP(incr,    DST,        DINT++)
OP(decr,    DST,        DINT--)
OP(addi,    DST KINT,   DINT += kint)
OP(addu,    DST KNAT,   DNAT += knat)
OP(subi,    DST KINT,   DINT -= kint)
OP(subu,    DST KNAT,   DNAT -= knat)
OP(muli,    DST KINT,   DINT *= kint)
OP(mulu,    DST KNAT,   DNAT *= knat)
OP(divi,    DST KINT,   DINT /= kint)
OP(divu,    DST KNAT,   DNAT /= knat)
OP(modi,    DST KINT,   DINT %= kint)
OP(modu,    DST KNAT,   DNAT %= knat)

OP(andu,    DST KNAT,   DNAT  &= knat)
OP(oru,     DST KNAT,   DNAT  |= knat)
OP(xoru,    DST KNAT,   DNAT  ^= knat)
OP(shlu,    DST KSHIFT, DNAT <<= kshift)
OP(shru,    DST KSHIFT, DINT >>= kshift)
OP(ushru,   DST KSHIFT, DNAT >>= kshift)

OP(frame,   DST SRC,    DNAT = (uintptr_t) &SNAT)

OP(st8,     DST SRC,    OTYPE(u64, DNAT, 0) = SNAT)
OP(st4,     DST SRC,    OTYPE(u32, DNAT, 0) = SNAT)
OP(st2,     DST SRC,    OTYPE(u16, DNAT, 0) = SNAT)
OP(st1,     DST SRC,    OTYPE(u8,  DNAT, 0) = SNAT)

OP(ld8,     DST SRC,    DNAT = OTYPE(u64, SNAT, 0))
OP(ld4,     DST SRC,    DNAT = OTYPE(u32, SNAT, 0))
OP(ld2,     DST SRC,    DNAT = OTYPE(u16, SNAT, 0))
OP(ld1,     DST SRC,    DNAT = OTYPE(u8,  SNAT, 0))

OP(st8o,    DST SRC KINT,       OTYPE(u64,DNAT, kint) = SNAT)
OP(st4o,    DST SRC KINT,       OTYPE(u32,DNAT, kint) = SNAT)
OP(st2o,    DST SRC KINT,       OTYPE(u16,DNAT, kint) = SNAT)
OP(st1o,    DST SRC KINT,       OTYPE(u8, DNAT, kint) = SNAT)

OP(ld8o,    DST SRC KINT,       DNAT = OTYPE(u64, SNAT, kint))
OP(ld4o,    DST SRC KINT,       DNAT = OTYPE(u32, SNAT, kint))
OP(ld2o,    DST SRC KINT,       DNAT = OTYPE(u16, SNAT, kint))
OP(ld1o,    DST SRC KINT,       DNAT = OTYPE(u8,  SNAT, kint))

OP(lds,     DST SRC KSHIFT,     DALL = sign_extend(OTYPE(u64,SNAT,0), kshift))
OP(ldos,    DST SRC KSHIFT KINT,DALL = sign_extend(OTYPE(u64,SNAT,kint), kshift))
OP(sext,    DST KSHIFT,         DALL = sign_extend(DALL, kshift))
OP(zext,    DST KSHIFT,         DALL = zero_extend(DALL, kshift))

OP(fadd,    DST SRC,    DFLT = DFLT + SFLT)
OP(fsub,    DST SRC,    DFLT = DFLT - SFLT)
OP(fmul,    DST SRC,    DFLT = DFLT * SFLT)
OP(fdiv,    DST SRC,    DFLT = DFLT / SFLT)

OP(dadd,    DST SRC,    DDBL = DDBL + SDBL)
OP(dsub,    DST SRC,    DDBL = DDBL - SDBL)
OP(dmul,    DST SRC,    DDBL = DDBL * SDBL)
OP(ddiv,    DST SRC,    DDBL = DDBL / SDBL)


#undef OP
#undef ROP
