OP(undef,       TOK; done = !resolve(t, called, pc))
OP(end,         done = true)

OP(int,         DST; KINT; DINT = kint)
OP(nat,         DST; KNAT; DNAT = knat)
OP(flt,         DST; memcpy(&DFLT, pc, sizeof(float)); pc += sizeof(float))
OP(dbl,         DST; memcpy(&DDBL, pc, sizeof(double)); pc += sizeof(double))
OP(txt,         DST; TOK; DINT = t)

OP(copy,        DST; SRC; DALL = SALL)
OP(swap,        DST; SRC; std::swap(DALL, SALL))
OP(ccopy,       PRED; DST; SRC; if (flags & PMASK) DALL = SALL)
OP(select,      PRED; DST; SRC; XTRA; DALL = (flags & PMASK) ? SALL : XALL)

OP(jmp,         TOK; JMP_TOK)
OP(call,        TOK; called = t; done = !push(value_t(pc)); JMP_TOK)
OP(ijmp,        SRC; pc = byte_p(SNAT))
OP(icall,       SRC; done = !push(value_t(pc)); pc = byte_p(SNAT))
OP(ret,         pc = byte_p(pop()))
OP(ppc,         push(value_t(pc)))
OP(pc,          DST; DNAT = uvalue_t(pc))
OP(pca,         DST; BR_OFF; DNAT = uvalue_t(bpc + b))
OP(enter,       DST; args = frame; frame = enter(d); done = !frame)
OP(leave,       frame = leave(); done = !frame; args = arguments())
OP(get,         DST; SRC; DINT = args[s])
OP(set,         DST; SRC; args[d] = SINT)
OP(push,        SRC; done = !push(SINT))
OP(pop,         DST; DINT = pop())
OP(sys,         TOK; FLUSH; done = !native(t); RESYNC)
OP(sto,         DST; SRC; globals[d] = SINT)
OP(rcl,         DST; SRC; DINT = globals[s])

OP(dbra,        DST; BR_OFF; if (--DNAT) BRANCH)
OP(bra,         BR_OFF; BRANCH)
OP(bcc,         PRED; BR_OFF; if (flags & PMASK) BRANCH)
OP(beq,         SRC; BR_OFF; if (SINT == 0) BRANCH)
OP(bne,         SRC; BR_OFF; if (SINT != 0) BRANCH)
OP(blt,         SRC; BR_OFF; if (SINT <  0) BRANCH)
OP(bgt,         SRC; BR_OFF; if (SINT >  0) BRANCH)
OP(ble,         SRC; BR_OFF; if (SINT <= 0) BRANCH)
OP(bge,         SRC; BR_OFF; if (SINT >= 0) BRANCH)

OP(true,        PRED; PCOND(true))
OP(false,       PRED; PCOND(false))
OP(cmpeq,       PRED; DST; SRC; PCOND(DINT == SINT))
OP(cmpne,       PRED; DST; SRC; PCOND(DINT != SINT))
OP(cmplt,       PRED; DST; SRC; PCOND(DINT <  SINT))
OP(cmpgt,       PRED; DST; SRC; PCOND(DINT >  SINT))
OP(cmple,       PRED; DST; SRC; PCOND(DINT <= SINT))
OP(cmpge,       PRED; DST; SRC; PCOND(DINT >= SINT))
OP(cmpule,      PRED; DST; SRC; PCOND(DNAT <= SNAT))
OP(cmpuge,      PRED; DST; SRC; PCOND(DNAT >= SNAT))
OP(cmpult,      PRED; DST; SRC; PCOND(DNAT <  SNAT))
OP(cmpugt,      PRED; DST; SRC; PCOND(DNAT >  SNAT))
OP(pushf,       rt.push(flags))
OP(popf,        flags = rt.pop<uint64_t>())

OP(dispatch,    SRC; pc = dispatch(pc, SINT))

OP(add,         DST; SRC; DINT += SINT)
OP(sub,         DST; SRC; DINT -= SINT)
OP(mul,         DST; SRC; DINT *= SINT)
OP(umul,        DST; SRC; DNAT *= SNAT)
OP(div,         DST; SRC; DINT /= SINT)
OP(udiv,        DST; SRC; DNAT /= SNAT)
OP(mod,         DST; SRC; DINT %= SINT)
OP(umod,        DST; SRC; DNAT %= SNAT)

OP(and,         DST; SRC; DNAT  &= SNAT)
OP(or,          DST; SRC; DNAT  |= SNAT)
OP(xor,         DST; SRC; DNAT  ^= SNAT)
OP(shl,         DST; SRC; DNAT <<= SNAT)
OP(shr,         DST; SRC; DINT >>= SNAT)
OP(ushr,        DST; SRC; DNAT >>= SNAT)
OP(neg,         DST; DNAT = -DNAT)
OP(not,         DST; DNAT = ~DNAT)

OP(incr,        DST; DINT++)
OP(decr,        DST; DINT--)
OP(addi,        DST; KINT; DINT += kint)
OP(addu,        DST; KNAT; DNAT += knat)
OP(subi,        DST; KINT; DINT -= kint)
OP(subu,        DST; KNAT; DNAT -= knat)
OP(muli,        DST; KINT; DINT *= kint)
OP(mulu,        DST; KNAT; DNAT *= knat)
OP(divi,        DST; KINT; DINT /= kint)
OP(divu,        DST; KNAT; DNAT /= knat)
OP(modi,        DST; KINT; DINT %= kint)
OP(modu,        DST; KNAT; DNAT %= knat)

OP(andu,        DST; KNAT; DNAT  &= knat)
OP(oru,         DST; KNAT; DNAT  |= knat)
OP(xoru,        DST; KNAT; DNAT  ^= knat)
OP(shlu,        DST; KSHIFT; DNAT <<= kshift)
OP(shru,        DST; KSHIFT; DINT >>= kshift)
OP(ushru,       DST; KSHIFT; DNAT >>= kshift)

OP(ld8,         DST; SRC; DNAT = *((uint64_t *) SNAT))
OP(ld4,         DST; SRC; DNAT = *((uint32_t *) SNAT))
OP(ld2,         DST; SRC; DNAT = *((uint16_t *) SNAT))
OP(ld1,         DST; SRC; DNAT = *((uint8_t  *) SNAT))
OP(ldf,         DST; SRC; DFLT = *((float    *) SNAT))
OP(ldd,         DST; SRC; DDBL = *((double   *) SNAT))
OP(st8,         DST; SRC; *((uint64_t *) DNAT) = SNAT)
OP(st4,         DST; SRC; *((uint32_t *) DNAT) = SNAT)
OP(st2,         DST; SRC; *((uint16_t *) DNAT) = SNAT)
OP(st1,         DST; SRC; *((uint8_t  *) DNAT) = SNAT)
OP(stf,         DST; SRC; *((float    *) DNAT) = SFLT)
OP(std,         DST; SRC; *((double   *) DNAT) = SDBL)

OP(fadd,        DST; SRC; DFLT = DFLT + SFLT)
OP(fsub,        DST; SRC; DFLT = DFLT - SFLT)
OP(fmul,        DST; SRC; DFLT = DFLT * SFLT)
OP(fdiv,        DST; SRC; DFLT = DFLT / SFLT)
OP(fmod,        DST; SRC; DFLT = std::fmod(DFLT, SFLT))

OP(dadd,        DST; SRC; DDBL = DDBL + SDBL)
OP(dsub,        DST; SRC; DDBL = DDBL - SDBL)
OP(dmul,        DST; SRC; DDBL = DDBL * SDBL)
OP(ddiv,        DST; SRC; DDBL = DDBL / SDBL)
OP(dmod,        DST; SRC; DDBL = std::fmod(DDBL, SDBL))

#undef OP
#undef ROP
