OP(end,         done = ok = true)

OP(copy,        DST; SRC; DINT = SINT)
OP(jmp,         TOK; JMP_TOK)
OP(call,        TOK; done = !push(value_t(pc)); JMP_TOK)
OP(ret,         pc = byte_p(pop()))
OP(enter,       DST; done = !enter(d))
OP(leave,       leave())
OP(push,        SRC; done = !push(SINT))
OP(pop,         DST; DINT = pop())

OP(dispatch,    SRC; pc = dispatch(pc, SINT))

OP(bra,         BR_OFF; BRANCH)
OP(beq,         SRC; BR_OFF; if (SINT == 0) BRANCH)
OP(bne,         SRC; BR_OFF; if (SINT != 0) BRANCH)
OP(blt,         SRC; BR_OFF; if (SINT <  0) BRANCH)
OP(bgt,         SRC; BR_OFF; if (SINT >  0) BRANCH)
OP(ble,         SRC; BR_OFF; if (SINT <= 0) BRANCH)
OP(bge,         SRC; BR_OFF; if (SINT >= 0) BRANCH)

OP(add,         DST; SRC; DINT += SINT)
OP(sub,         DST; SRC; DINT -= SINT)
OP(mul,         DST; SRC; DINT *= SINT)
OP(umul,        DST; SRC; DNAT *= SNAT)
OP(div,         DST; SRC; DINT /= SINT)
OP(udiv,        DST; SRC; DNAT /= SNAT)
OP(mod,         DST; SRC; DINT %= SINT)
OP(umod,        DST; SRC; DNAT %= SNAT)

OP(and,         DST; SRC; DNAT  &= SNAT)
OP(or,          DST; SRC; DNAT  |= SNAT)
OP(xor,         DST; SRC; DNAT  ^= SNAT)
OP(shl,         DST; SRC; DNAT <<= SNAT)
OP(shr,         DST; SRC; DINT >>= SNAT)
OP(shru,        DST; SRC; DNAT >>= SNAT)
OP(neg,         DST; DNAT = -DNAT)
OP(not,         DST; DNAT = ~DNAT)

OP(int,         DST;  DINT = arg< value_t>(pc))
OP(uint,        DST; DNAT = arg<uvalue_t>(pc))
OP(txt,         DST;  DINT = arg<tok_t>(pc))
OP(swap,        DST; SRC; std::swap(DINT, SINT))

OP(err,         if (utf8 msg = error()) if (!(std::cerr << msg)) ok = false)
OP(clear,       error(nullptr))
OP(trap,        BR_OFF; if (error()) BRANCH)
OP(eof,         BR_OFF; if (!std::cin.good()) BRANCH)
OP(inpc,        DST; if (std::cin) DINT = input<char>())
OP(inpi,        DST; if (std::cin) DINT = input<value_t>())
OP(inpu,        DST; if (std::cin) DINT = input<uvalue_t>())
OP(inpt,        DST; if (std::cin) DINT = input_text(*this))
OP(outc,        SRC; output<char>(SINT))
OP(outi,        SRC; output<value_t>(SINT))
OP(outu,        SRC; output<uvalue_t>(SNAT))
OP(outt,        SRC; output_text(*this, SINT))
OP(outl,        output_newline())

#undef OP
