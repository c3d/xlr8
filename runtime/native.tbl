NATIVE(globals,         rt.globals.resize(rt.arg<size_t>()))
NATIVE(malloc,          DST; SRC; DNAT = value_t(malloc(SNAT)))
NATIVE(kmalloc,         DST; ARG(size_t, sz); DNAT = value_t(malloc(sz)))
NATIVE(realloc,         DST; SRC; DNAT = value_t(realloc((void *) DNAT, SNAT)))
NATIVE(free,            DST; free((void *) DNAT))
NATIVE(alloca,          DST; KINT; DTYPE(stack_p) = rt.alloca(kint))
NATIVE(valloca,         DST; SRC; DTYPE(stack_p) = rt.alloca(SINT))

NATIVE(cmdline,         DST; SRC; DNAT = rt.argv(SNAT))
NATIVE(env,             DST; SRC; DNAT = rt.env(SNAT))

NATIVE(infix,           rt.infix())
NATIVE(prefix,          rt.prefix())
NATIVE(postfix,         rt.postfix())
NATIVE(block,           rt.block())
NATIVE(builtin,         rt.parsing_mode(false))
NATIVE(parsing,         rt.parsing_mode(true))

NATIVE(branch_on_eof,   BR_OFF; ISTREAM; if (in && (*in).eof()) BRANCH)
NATIVE(branch_on_bad,   BR_OFF; ISTREAM; if (in && (*in).bad()) BRANCH)

NATIVE(read_char,       DST; ISTREAM; ISTREAM_RD(char,     DINT))
NATIVE(read_integer,    DST; ISTREAM; ISTREAM_RD(value_t,  DINT))
NATIVE(read_natural,    DST; ISTREAM; ISTREAM_RD(uvalue_t, DNAT))
NATIVE(read_float,      DST; ISTREAM; ISTREAM_RD(float,    DFLT))
NATIVE(read_double,     DST; ISTREAM; ISTREAM_RD(double,   DDBL))

NATIVE(write_char,      OSTREAM; SRC; OSTREAM_WR(char(SINT)))
NATIVE(write_integer,   OSTREAM; SRC; OSTREAM_WR(SINT))
NATIVE(write_natural,   OSTREAM; SRC; OSTREAM_WR(SNAT))
NATIVE(write_float,     OSTREAM; SRC; OSTREAM_WR(SFLT))
NATIVE(write_double,    OSTREAM; SRC; OSTREAM_WR(SDBL))
NATIVE(write_text,      OSTREAM; SRC; OSTREAM_WR(rt.as_text(SNAT)))
NATIVE(write_newline,   OSTREAM; OSTREAM_WR('\n'))

NATIVE(read_scanner,    DST; ISTREAM; scanner::scan(in, d, d+1, rt))
NATIVE(nat,             SRC; OSTREAM; scanner::append(out, SNAT))
NATIVE(int,             SRC; OSTREAM; scanner::append(out, SINT))
NATIVE(flt,             SRC; OSTREAM; scanner::append(out, SFLT))
NATIVE(dbl,             SRC; OSTREAM; scanner::append(out, SDBL))

NATIVE(print_error,     OSTREAM; if (out) if (utf8 e = rt.error()) *out << e)
NATIVE(clear_error,     rt.error(nullptr))
NATIVE(trap_error,      BR_OFF; if (rt.error()) BRANCH)

NATIVE(i2f,             DST; SRC; DFLT = SINT)
NATIVE(i2d,             DST; SRC; DDBL = SINT)
NATIVE(u2f,             DST; SRC; DFLT = SNAT)
NATIVE(u2d,             DST; SRC; DDBL = SNAT)
NATIVE(f2i,             DST; SRC; DINT = value_t(SFLT))
NATIVE(d2i,             DST; SRC; DINT = value_t(SDBL))
NATIVE(f2u,             DST; SRC; DNAT = uvalue_t(SFLT))
NATIVE(d2u,             DST; SRC; DNAT = uvalue_t(SDBL))
NATIVE(f2d,             DST; SRC; DDBL = SFLT)
NATIVE(d2f,             DST; SRC; DFLT = SDBL)
NATIVE(fpush,           SRC; done = !rt.push(SFLT))
NATIVE(dpush,           SRC; done = !rt.push(SDBL))
NATIVE(fpop,            DST; DFLT = rt.pop<float>())
NATIVE(dpop,            DST; DDBL = rt.pop<double>())

#define REAL_OP(name)                                           \
NATIVE(f##name,         DST; SRC; DFLT = std::name(SFLT))       \
NATIVE(d##name,         DST; SRC; DDBL = std::name(SDBL))

REAL_OP(floor)
REAL_OP(ceil)
REAL_OP(sqrt)
REAL_OP(cbrt)
REAL_OP(sin)
REAL_OP(cos)
REAL_OP(tan)
REAL_OP(asin)
REAL_OP(acos)
REAL_OP(atan)
REAL_OP(exp)
REAL_OP(log)
REAL_OP(exp2)
REAL_OP(log2)

#undef REAL_OP

#define REAL_CMP(name, cond)                                    \
NATIVE(f##name,         PRED; DST; SRC; PCOND(DFLT cond SFLT))  \
NATIVE(d##name,         PRED; DST; SRC; PCOND(DDBL cond SDBL))

REAL_CMP(cmpeq, == )
REAL_CMP(cmpne, != )
REAL_CMP(cmplt, <  )
REAL_CMP(cmpgt, >  )
REAL_CMP(cmple, <= )
REAL_CMP(cmpge, >= )

NATIVE(stack,   DST; DNAT = (uintptr_t) rt.stack)

NATIVE(st8v,    DST; SRC; OTYPE(volatile u64, DNAT, 0) = SNAT)
NATIVE(st4v,    DST; SRC; OTYPE(volatile u32, DNAT, 0) = SNAT)
NATIVE(st2v,    DST; SRC; OTYPE(volatile u16, DNAT, 0) = SNAT)
NATIVE(st1v,    DST; SRC; OTYPE(volatile u8,  DNAT, 0)  = SNAT)
NATIVE(ld8v,    DST; SRC; DNAT = OTYPE(volatile u64, SNAT, 0))
NATIVE(ld4v,    DST; SRC; DNAT = OTYPE(volatile u32, SNAT, 0))
NATIVE(ld2v,    DST; SRC; DNAT = OTYPE(volatile u16, SNAT, 0))
NATIVE(ld1v,    DST; SRC; DNAT = OTYPE(volatile u8,  SNAT, 0))
NATIVE(ld8vs,   DST; SRC; DINT = OTYPE(volatile i64, SNAT, 0))
NATIVE(ld4vs,   DST; SRC; DINT = OTYPE(volatile i32, SNAT, 0))
NATIVE(ld2vs,   DST; SRC; DINT = OTYPE(volatile i16, SNAT, 0))
NATIVE(ld1vs,   DST; SRC; DINT = OTYPE(volatile i8,  SNAT, 0))

NATIVE(ld8s,    DST; SRC; DINT = OTYPE(i64, SNAT, 0))
NATIVE(ld4s,    DST; SRC; DINT = OTYPE(i32, SNAT, 0))
NATIVE(ld2s,    DST; SRC; DINT = OTYPE(i16, SNAT, 0))
NATIVE(ld1s,    DST; SRC; DINT = OTYPE(i8,  SNAT, 0))

NATIVE(ld8os,   DST; SRC; KINT; DINT = OTYPE(i64,SNAT,kint))
NATIVE(ld4os,   DST; SRC; KINT; DINT = OTYPE(i32,SNAT,kint))
NATIVE(ld2os,   DST; SRC; KINT; DINT = OTYPE(i16,SNAT,kint))
NATIVE(ld1os,   DST; SRC; KINT; DINT = OTYPE(i8, SNAT,kint))

NATIVE(sext,    DST; KSHIFT;
                ularge_t sign = (1ULL << (kshift - 1));
                ularge_t mask = (1ULL << kshift) - 1ULL;
                ularge_t val  = DALL;
                DALL = ((val & sign) ? (~(~val & mask)) : (val & mask)))
NATIVE(zext,    DST; KSHIFT;
                ularge_t mask = (1ULL << kshift) - 1ULL;
                DALL &= mask)

NATIVE(tok,     DST; SRC; DNAT = rt.tokaddr(SNAT))
NATIVE(leb2i,   DST; SRC; DINT = leb128<value_t>(SRPTR))
NATIVE(leb2u,   DST; SRC; DNAT = leb128<uvalue_t>(SRPTR))
NATIVE(i2leb,   DST; SRC; DWPTR = leb128(DWPTR, SINT))
NATIVE(u2leb,   DST; SRC; DWPTR = leb128(DWPTR, SNAT))
NATIVE(i2lebsz, DST; SRC; DNAT = leb128size(SINT))
NATIVE(u2lebsz, DST; SRC; DNAT = leb128size(SNAT))

#undef NATIVE
