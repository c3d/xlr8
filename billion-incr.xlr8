// Example counting to 1 billion

// Reserve four registers
enter 4

// Prepare registers
nat 0 2                         // R0 = 2, counter
nat 2 1_000_000_000             // R2 = 1 billion, limit

.loop                           // Loop
incr 0                          // Add R1 to R0
copy 3 0                        // Copy counter in temporary R3
sub 3 2                         // Counter - 1M
blt 3 :loop                     // If not zero, loop

// Exit loop, display final counter
txt 3 "I="                      // Put token for "I=" in R3
sys write_text 3 1              // Emit text on std::cout
sys write_integer 0 1           // Emit counter
sys write_newline 1             // Emit end of line
