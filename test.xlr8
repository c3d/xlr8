// Example counting to 1 billion

// Reserve four registers
enter 4

// Prepare registers
nat 0 2                        // R0 = 2, counter
nat 1 1                        // R1 = 1, increment
nat 2 100_000_000              // R2 = 100 million, limit

.loop                           // Loop
add 0 1                         // Add R1 to R0
copy 3 0                        // Copy counter in temporary R3
mod 3 2                         // Counter modulo 1 billion
bne 3 :loop                     // If not zero, loop

// Exit loop, display final counter
txt 3 "I="                      // Put token for "I=" in R3
outt 3                          // Emit text on std::cout
outi 0                          // Emit counter
outl                            // Emit end of line

bra :loop
