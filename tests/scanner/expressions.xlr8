// Compile-time expressions in operands

[STDOUT 1]
[Reg[n]
 sys write_integer STDOUT n
 sys write_newline STDOUT]
[Txt[n]
 sys write_text    STDOUT n
 sys write_newline STDOUT]
[Dbl[n]
 sys write_double  STDOUT n
 sys write_newline STDOUT]

nat 0 #(1+2)
Reg 0

nat 1 #(1+2*3)
Reg 1

nat 2 #(7&3)
Reg 2

nat 3 #(5^2)
Reg 3

txt 4 ("ABC"+"DEF")
Txt 4

nat 5 (null+42)
Reg 5

dbl 5 (null+42.42)
Dbl 5

[inc[r] nat 0 (r+1)]
nat 0 #0
inc 0
Reg 0

nat 6 #0
addi 6 #(1+2)
Reg 6

nat 3 #(3*(4-2))
Reg 3

nat 3 #(33 % 17)
Reg 3

nat 3 #(~"ABCDEF")
Reg 3

nat 7 'E'
Reg 7

nat 6 '▶'
Reg 6

pca 4 :text
pca 5 :textend
sub 5 4
.loop
  ld1 0 4
  sys write_char STDOUT 0
  incr 4
  dbra 5 :loop
sys write_newline STDOUT

txt 2 ((5 * "Hello" & 2 * "World") * 3)
Txt 2

txt 3 ("X=" & 1 & " and Y=" & 2*3)
Txt 3

txt 3 (("My Hello World is Truncated????" + 3) - 4 & "!")
Txt 3

txt 3 ("My Other Hello World is Also Truncated????" + 3 - 4 & "!")
Txt 3

end

.text #("Hello " & "World") .textend
