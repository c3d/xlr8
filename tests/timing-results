#!/bin/bash
printf "%10s %-40s %8s %8s %8s\n" "OPT" "TEST" "TIME" "REF" "%CHG"
for I in $(find . -name '*.time');
do
    stem=${I%.time}
    base=${stem##*/}
    name=${base%%.xlr8*}
    rest=${base#*.xlr8}
    oplevel=${rest%%.*}
    target=${rest#*.}
    [ "$oplevel" = "$rest" ] && oplevel="" && target=$rest
    label=${oplevel:+$oplevel.}${target}
    export time=$(cat $I)
    export ref=$(cat ${I}ref)
    pctchg=$(echo "scale=3;100.0*($time-$ref)/$time" | bc)
    printf "%10s %-40s %8s %8s %8s\n" "$label" "$name" "$time" "$ref" "$pctchg"
done | sort
