#!/bin/bash
printf "%5s %-30s %8s %8s %8s\n" "OPT" "TEST" "TIME" "REF" "%CHG"
for I in $(find . -name '*.time');
do
    base=$(echo $I | sed 's|.*/performance/||g')
    name=$(echo $base | sed 's/[.]xlr8.*time//g')
    opt=$(echo $base | sed -e 's/.*[.]xlr8[.]//g' -e 's/[.]time//g')
    export time=$(cat $I)
    export ref=$(cat ${I}ref)
    pctchg=$(echo "scale=3;100.0*($time-$ref)/$time" | bc)
    printf "%5s %-30s %8s %8s %8s\n" $opt $name $time $ref $pctchg
done | sort
