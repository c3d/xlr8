// Check that we can read the command line arguments
// CMD= %x -m 40 %f -- hello world


nat 0 0

.loop
  txt 1 "arg["
  sys write_text 1 1
  sys write_integer 0 1
  txt 1 "]='"
  sys write_text 1 1
  sys cmdline 2 0
  sys write_text 2 1
  txt 1 "'"
  sys write_text 1 1
  sys write_newline 1
  incr 0
 bne 2 :loop
