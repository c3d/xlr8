// Test recursive definition of fibonacci, displaying fib(40)
// CMD=./time %x %f 2>&1 | ./filter-time %f
// CHECK=./check-time %f
// TIMEOUT=500

=fib
ble 0 :return0
decr 0
ble 0 :return1
enter 2
get 0 0
decr 0
call *fib
copy 1 0
get 0 0
call *fib
add 0 1
set 0 0
leave
ret

.return1
nat 0 1
.return0
ret
;

nat 0 40                       // R0 = 40
txt 1 "Fibonacci of "

[STDOUT 1]

sys write_text STDOUT 1
sys write_integer STDOUT 0
txt 1 " is "
sys write_text STDOUT 1
call *fib                      // R0 = fib(40)
sys write_integer STDOUT 0
sys write_newline STDOUT
