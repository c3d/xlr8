// Check that we can read the command line arguments
// CMD=./time %x %f 2>&1 | ./filter-time %f
// CHECK=./check-time %f
// TIMEOUT=500

nat 0 0

.loop
  txt 1 "arg["

[STDOUT 1]

  sys write_text STDOUT 1
  sys write_integer STDOUT 0
  txt 1 "]='"
  sys write_text STDOUT 1
  sys cmdline 2 0
  sys write_text STDOUT 2
  txt 1 "'"
  sys write_text STDOUT 1
  sys write_newline STDOUT
  incr 0
 bne 2 :loop

nat 0 0
nat 1 50_000_000
.perfloop
  sys cmdline 2 0
 dbra 1 :perfloop

txt 1 "Done!"
sys write_text STDOUT 1
sys write_newline STDOUT
