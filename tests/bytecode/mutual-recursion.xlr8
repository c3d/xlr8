// Mutually recursive foo and bar:
//   foo(0) = 0,  foo(n) = bar(n-1) + 1
//   bar(0) = 0,  bar(n) = foo(n-1) + 2

?foo
?bar

=foo
ble 0 :done
subu 0 1
call *bar
incr 0
ret
.done
nat 0 0
ret
;

=bar
ble 0 :done
subu 0 1
call *foo
incr 0
incr 0
ret
.done
nat 0 0
ret
;

nat 0 5
call *foo
txt 1 "foo(5)="

[STDOUT 1]

sys write_text STDOUT 1
sys write_integer STDOUT 0
sys write_newline STDOUT
end
