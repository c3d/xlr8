// Check that we have a nested function definition
.label
  int 0 :label

[STDOUT 1]

  sys write_integer STDOUT 0
  sys write_newline STDOUT
  int 0 (staff-stuff+42)
  sys write_integer STDOUT 0
  sys write_newline STDOUT
  txt 1 "Outer "
  txt 2 "Inner "

// Define function stuff
=stuff
  // Nested function staff
  =staff
  addi 0 1
[STDOUT 1]

  sys write_text    STDOUT 1
  sys write_text    STDOUT 2
  sys write_integer STDOUT 0
  sys write_newline STDOUT
  ret
  ;
txt 2 "staff[1] "
call *staff
txt 2 "staff[2] "
call *staff
ret
;

txt 1 "Staff[1] "
call *staff
txt 1 "Stuff[2] "
call *stuff
txt 1 "Staff[3] "
call *staff
end
