// Check that we can use sys functions to write stuff to standard error


int 0 #42
sys write_integer 2 0
sys write_newline 2

nat 0 #4547
sys write_natural 2 0
sys write_newline 2

flt 0 42.4547f
sys write_float   2 0
sys write_newline 2

dbl 0 3.1415926
sys write_double  2 0
sys write_newline 2

txt 0 "Hello, did the test succeed?"
sys write_text    2 0
sys write_newline 2
end
