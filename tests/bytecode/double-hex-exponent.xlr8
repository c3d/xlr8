// XL hex real with decimal exponent (16#1.FFFF_FFFF#E3)

dbl 0
16#1.FFFF_FFFF#E3
txt 1 "16#1.FFFF_FFFF#E3="

[STDOUT 1]

sys write_text STDOUT 1
sys write_double STDOUT 0
sys write_newline STDOUT

dbl 0
16#1.A#E3
txt 1 "16#1.A#E3="
sys write_text STDOUT 1
sys write_double STDOUT 0
sys write_newline STDOUT
