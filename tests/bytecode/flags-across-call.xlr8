// Sticky flags across call: enter/leave do not clear or restore predicates.
// Callee-set bits (including high preds) remain visible after return.
// Use pushf/popf in the callee if isolation is required.

=foo
enter 8
true 2
true 17
leave
ret
;

[STDOUT 1]
[Msg[msg]
 sys write_token   STDOUT msg
 sys write_newline STDOUT]

true 2
true 3
true 18

bfalse 2 :problem
  Msg "Flags 2 is set, OK"
.problem
btrue 3 :ok1
  Msg "Flag 3 is clear, BAD!"
.ok1

nat 0 #42
cmpequ 4 0 #4242

pushf
pop 0
sys write_token   STDOUT "Flags  Pre-Call="
sys write_integer STDOUT 0
sys write_newline STDOUT


call *foo

bfalse 4 :ok2
  Msg "Flag 4 is set, BAD!"
.ok2
btrue 18 :ok3
  Msg "Flag 18 was cleared, BAD!"
.ok3
btrue 17 :ok4
  Msg "Flag 17 was cleared, BAD!"
.ok4

pushf
pop 0
sys write_token   STDOUT "Flags Post-Call="
sys write_integer STDOUT 0
sys write_newline STDOUT

end
