// Sticky flags: enter/leave do not save or restore predicates.
// Callee updates remain visible after leave.

true 0
enter 1
false 0
leave
bfalse 0 :ok_clear
txt 0 "FAIL sticky clear"
bra :done
.ok_clear
txt 0 "OK sticky clear"
.done

[STDOUT 1]

sys write_text STDOUT 0
sys write_newline STDOUT

false 5
enter 1
true 5
leave
btrue 5 :ok_set
txt 0 "FAIL sticky set"
bra :write
.ok_set
txt 0 "OK sticky set"
.write
sys write_text STDOUT 0
sys write_newline STDOUT
end
