// Check that we can read our own code
// CMD=%x -d 199 %f

[WRITE 199]

// Load a constant and display it
WRITE #"Constant FOO (numerical value): " 0
nat 0 *FOO

[STDOUT 1]

sys write_integer STDOUT 0
sys write_newline STDOUT

// Load a token constant and display it
WRITE #"Load token for generated code: " 0
nat 0 *BAR
sys write_integer STDOUT 0
sys write_newline STDOUT

// Load address for BAR
WRITE #"Read token address" 10 0
sys tok 1 0

// Write each byte of BAR code
// It should start with 9
.loop
    WRITE #"  " 0
    ld1 0 1
    sys write_integer STDOUT 0
    sys write_newline STDOUT
    incr 1
    bne 0 :loop
end

!FOO 2

=BAR 1 2 3 42 #"XYZ" 0 end;
