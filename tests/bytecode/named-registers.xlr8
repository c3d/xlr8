// This tests if we can used named registers

!INDEX          0
!TEXT           1
!TMP            2
!REGS           3
!STDOUT         1
!LOOPS          42
!MULTIPLIER     21


nat *INDEX *LOOPS
.loop
    sys write_integer *STDOUT *INDEX
    txt *TEXT "x"
    sys write_text *STDOUT *TEXT
    nat *TEXT *MULTIPLIER
    sys write_integer *STDOUT *TEXT
    txt *TEXT "="
    sys write_text *STDOUT *TEXT
    copy *TMP *INDEX
    mulu *TMP *MULTIPLIER
    sys write_integer *STDOUT *TMP
    sys write_newline *STDOUT
    dbra *INDEX :loop
