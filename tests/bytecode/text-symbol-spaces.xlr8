// User opcode with a quoted name containing spaces
// Also case where we redefine an opcode after setting it to something

?"foo bar zoo"

="foo bar zoo"
nat 0 42
ret
;

call *"foo bar zoo"
txt 1 "foo bar zoo="

[STDOUT 1]

sys write_text STDOUT 1
sys write_integer STDOUT 0
sys write_newline STDOUT
