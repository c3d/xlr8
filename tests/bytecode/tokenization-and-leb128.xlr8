// Check that we can read the tokens and the LEB128 data

nat 0 0                                 // R0: Token index

.loop
  sys tok 1 0                           // R1: Token address
  beq 1 :done                           //  done if nullptr

  // Write tok[n]=(size) 'tokval'
  txt 2 "tok["                          // R2: Text / temporary

[STDOUT 1]

  sys write_text    STDOUT 2
  sys write_integer STDOUT 0
  txt 2 "]=("
  sys write_text    STDOUT 2

  sys leb2u 3 1                         // R3: length
  sys write_natural STDOUT 3
  txt 2 ") '"
  sys write_text    STDOUT 2

  beq 3 :empty

  .chars
    ld1 2 1
    incr 1
    nat 5 32
    sub 5 2
    bgt 5 :charval
    nat 5 126
    sub 5 2
    blt 5 :charval
    sys write_char STDOUT 2
    dbra 3 :chars
    bra :empty

  .charval
    txt 5 "["
    sys write_text STDOUT 5
    sys write_integer STDOUT 2
    txt 5 "]"
    sys write_text STDOUT 5
    dbra 3 :chars

  .empty

  txt 2 "'"
  sys write_text STDOUT 2
  sys write_newline STDOUT

  incr 0
  bra :loop

.done

txt 0 "Done!"
sys write_text  STDOUT 0
sys write_newline STDOUT
end
