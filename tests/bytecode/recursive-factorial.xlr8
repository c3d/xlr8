// Test recursive definition of the factorial, displaying 1! through 10!

=fact
ble 0 :return1
push 0
subu 0 1
call *fact
pop 1
umul 0 1
ret
.return1
nat 0 1
ret
;

nat 0 1                         // R0 = n, starts at 1

.loop
copy 3 0                        // Save n for printing
copy 1 3
subi 1 10                       // Exit when n > 10
bgt 1 :done
call *fact                      // R0 = n!
txt 1 "Factorial "

[STDOUT 1]

sys write_text STDOUT 1
sys write_integer STDOUT 3
txt 1 " is "
sys write_text STDOUT 1
sys write_integer STDOUT 0
sys write_newline STDOUT
incr 3                          // n++
copy 0 3                        // R0 = n for next iteration
bra :loop

.done
end
