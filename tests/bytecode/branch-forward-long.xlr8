// Forward branch past 1-byte LEB128 limit (delta >= 64, grows to 2 bytes)
// R0 must stay 99: falling through any addi would change the output

enter 2
nat 0 99
bra :target
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
addi 0 1
.target
outi 0
outl
