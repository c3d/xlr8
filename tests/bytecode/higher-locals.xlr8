// Locals >= 16 are frame-only on arm64; must not touch HW shadow registers.
// Default frame is enter 8; need enter >= 19 to legally use locals 16–18.

enter 255

[STDOUT 1]
[SetN [n]
 nat n #(1000000*n*n+100*n)
 sys write_token STDOUT "Init "
 sys write_integer STDOUT n
 sys write_newline STDOUT]

[ModifyN [n]
 addi n +42
 sys write_token STDOUT "Modified "
 sys write_integer STDOUT n
 sys write_newline STDOUT]

