// Test recursive definition of fibonacci, displaying fib(40)

=fib
ble 0 :return0
decr 0
ble 0 :return1
enter 2
get 0 0
decr 0
call *fib
copy 1 0
get 0 0
call *fib
add 0 1
set 0 0
leave
ret

.return1
nat 0 1
.return0
ret
;

nat 0 0                         // R0 = n, starts at 0

.loop
copy 3 0                        // Save n for printing
copy 1 3
subi 1 10                       // Exit when n > 10
bgt 1 :done
call *fib                      // R0 = n!
txt 1 "Fibonacci of "

[STDOUT 1]

sys write_text STDOUT 1
sys write_integer STDOUT 3
txt 1 " is "
sys write_text STDOUT 1
sys write_integer STDOUT 0
sys write_newline STDOUT
incr 3                          // n++
copy 0 3                        // R0 = n for next iteration
bra :loop

.done
