// Example counting to 1 billion

// Reserve four registers
enter 2

// Prepare registers
nat 0 2                         // R0 = 2, counter
nat 1 1_000_000_000             // R2 = 1 billion, limit

.loop                           // Loop
dbra 1 :loop                    // Decrement and if not zero, loop

// Exit loop, display final counter
txt 1 "I="                      // Put token for "I=" in R3
outt 1                          // Emit text on std::cout
outi 0                          // Emit counter
outl                            // Emit end of line
