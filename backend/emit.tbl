OP(pca, { byte d = *pc++; byte_p bpc = pc; broff_t b = leb128<broff_t>(pc); set_branch_target(bpc + b); emit_pca(d, b); })
OP(enter, { byte d = *pc++; emit_enter(d); })
OP(leave, emit_leave())
