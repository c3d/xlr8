OP(dispatch, { byte s = *pc++; byte_p table = pc; size_t ncases = leb128<size_t>(pc); for (size_t n = 0; n < ncases; n++) { leb128<value_t>(pc); leb128<broff_t>(pc); } emit_dispatch(s, table); })
