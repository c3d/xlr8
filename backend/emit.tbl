OP(null, emit_null())
OP(undef, { tok_t t = leb128<tok_t>(pc); emit_undef(t); })
OP(end, translating = false)
OP(int, { byte d = *pc++; value_t kint = leb128<value_t>(pc); emit_int(d, kint); })
OP(nat, { byte d = *pc++; uvalue_t knat = leb128<uvalue_t>(pc); emit_nat(d, knat); })
OP(flt, { byte d = *pc++; float fv; memcpy(&fv, pc, sizeof(float)); pc += sizeof(float); emit_flt(d, fv); })
OP(dbl, { byte d = *pc++; double dv; memcpy(&dv, pc, sizeof(double)); pc += sizeof(double); emit_dbl(d, dv); })
OP(txt, { byte d = *pc++; tok_t t = leb128<tok_t>(pc); emit_txt(d, t); })
OP(copy, { byte d = *pc++; byte s = *pc++; emit_copy(d, s); })
OP(swap, { byte d = *pc++; byte s = *pc++; emit_swap(d, s); })
OP(ccopy, { byte p = *pc++; byte d = *pc++; byte s = *pc++; emit_ccopy(p, d, s); })
OP(select, { byte p = *pc++; byte d = *pc++; byte s = *pc++; byte x = *pc++; emit_select(p, d, s, x); })
OP(jmp, { tok_t t = leb128<tok_t>(pc); emit_jmp(t); })
OP(call, { tok_t t = leb128<tok_t>(pc); emit_call(t); })
