OP(pop, { byte d = *pc++; emit_pop(d); })
OP(sys, { tok_t t = leb128<tok_t>(pc); byte_p args = pc; xlr8_skip_sys_args(t, pc); byte_p next = pc; emit_sys(t, args, next); })
